# Public deployment URL. Leave unset locally; do not substitute a guessed production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INDEXING_ENABLED=false
NEXT_PUBLIC_IDENTITY_APPROVED=false

# Supabase browser-safe configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Never expose this value through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Public enquiries remain off unless both values are configured at a trusted edge/proxy.
# The proxy must overwrite (not merely forward) the chosen header.
ENQUIRY_TRUSTED_IP_HEADER=x-forwarded-for
ENQUIRY_FINGERPRINT_PEPPER=

# Protects the scheduled enquiry-retention job when a hosting cron invokes it.
CRON_SECRET=

# Optional Sentry-compatible monitoring. Monitoring is disabled when unset.
NEXT_PUBLIC_ERROR_MONITORING_DSN=
